// SPDX-License-Identifier: Apache-2.0
// Internal implementation candidate. Only the selected debug proof installs its helper.
cc_library_headers {
    name: "andrix_delegated_init_headers",
    host_supported: true,
    recovery_available: true,
    ramdisk_available: true,
    vendor_ramdisk_available: true,
    export_include_dirs: ["init"],
}
filegroup {
    name: "andrix_lmkd_service_protocol_sources",
    srcs: ["lmkd/protocol_test.cpp"],
}
filegroup {
    name: "andrix_delegated_init_sources",
    srcs: ["init/delegated_service.cpp"],
}
filegroup {
    name: "andrix_delegated_profile_test_sources",
    srcs: ["init/profile_test.cpp"],
}
cc_library_static {
    name: "andrix_delegated_scope",
    host_supported: true,
    recovery_available: true,
    ramdisk_available: true,
    vendor_ramdisk_available: true,
    bootstrap: true,
    cpp_std: "c++20",
    cflags: ["-Wall", "-Wextra", "-Werror"],
    srcs: ["native/captured_cgroup.cpp", "native/instance_state.cpp", "native/cleanup_worker.cpp", "native/service_handoff.cpp"],
    export_include_dirs: ["native"],
}

cc_test_host {
    name: "andrix_delegated_state_test",
    compile_multilib: "first",
    gtest: false,
    cpp_std: "c++20",
    cflags: ["-Wall", "-Wextra", "-Werror", "-UNDEBUG"],
    srcs: ["tests/instance_state_test.cpp"],
    static_libs: ["andrix_delegated_scope"],
}

cc_test_host {
    name: "andrix_captured_group_test",
    compile_multilib: "first",
    gtest: false,
    cpp_std: "c++20",
    cflags: ["-Wall", "-Wextra", "-Werror", "-UNDEBUG"],
    srcs: ["tests/captured_cgroup_test.cpp"],
    static_libs: ["andrix_delegated_scope"],
}

cc_test_host {
    name: "andrix_cleanup_worker_test",
    compile_multilib: "first",
    gtest: false,
    cpp_std: "c++20",
    cflags: ["-Wall", "-Wextra", "-Werror", "-UNDEBUG"],
    srcs: ["tests/cleanup_worker_test.cpp"],
    static_libs: ["andrix_delegated_scope"],
}

cc_test_host {
    name: "andrix_service_handoff_test",
    compile_multilib: "first",
    gtest: false,
    cpp_std: "c++20",
    cflags: ["-Wall", "-Wextra", "-Werror", "-UNDEBUG"],
    srcs: ["tests/service_handoff_test.cpp"],
    static_libs: ["andrix_delegated_scope"],
}

cc_binary {
    name: "andrix-scope-cleaner",
    system_ext_specific: true,
    bootstrap: true,
    cpp_std: "c++20",
    cflags: ["-Wall", "-Wextra", "-Werror"],
    srcs: ["native/cleanup_worker_main.cpp"],
    static_libs: ["andrix_delegated_scope"],
    shared_libs: ["libselinux"],
}

cc_binary {
    name: "andrix-delegated-link-probe",
    installable: false,
    cpp_std: "c++20",
    cflags: ["-Wall", "-Wextra", "-Werror"],
    srcs: ["tests/link_probe.cpp"],
    static_libs: ["andrix_delegated_scope"],
}
