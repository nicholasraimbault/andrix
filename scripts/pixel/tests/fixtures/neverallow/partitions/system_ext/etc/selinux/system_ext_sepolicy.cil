; SYNTHETIC system_ext policy: the owner policy's own types.
(type andrix_terminal)
(type andrix_owner_devpts)
(type andrixd_devpts)
(type andrixd_exec)
(type andrix_owner_entry)
(type andrix_owner_pid_prop)
(type andrix_console_socket)
(type andrix_session_service)
(type andrix_lifecycle_service)
(type ctl_andrix_owner_prop)
(roletype r andrix_terminal)
(typeattributeset domain (andrix_terminal))
(allow andrix_owner andrix_owner_devpts (chr_file (open read write ioctl)))
(allow andrixd andrixd_devpts (chr_file (open read write ioctl)))
(allow andrixd andrix_owner_entry (file (read open execute)))
(allow andrix_owner andrix_owner_entry (file (read open entrypoint)))
(allow init andrixd_exec (file (read open execute)))
(allow andrixd andrixd_exec (file (read open entrypoint)))
(allow andrixd andrix_owner_pid_prop (property_service (set)))
(allow andrixd andrix_console_socket (unix_stream_socket (read write)))
(allow andrixd andrix_session_service (service_manager (add find)))
(allow system_server ctl_andrix_owner_prop (property_service (set)))
; the owner's devpts ioctls, as create_pty restricts them, and the rule the macro emits
(allowx andrix_owner andrix_owner_devpts (ioctl chr_file (0x5401)))
(neverallowx domain andrix_owner_devpts (ioctl chr_file (0x5412)))
