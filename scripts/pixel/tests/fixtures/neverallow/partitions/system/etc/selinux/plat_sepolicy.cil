; SYNTHETIC platform policy for the neverallow check tests. Every class, permission and type
; that the 28 Andrix rules and their witnesses name is declared, and nothing more.
(mls true)
(handleunknown deny)
(class file (read write append open execute execute_no_trans entrypoint ioctl getattr create unlink map))
(class dir (open read write add_name remove_name search getattr))
(class lnk_file (open read write execute))
(class fifo_file (open read write execute))
(class sock_file (create open read write unlink))
(class chr_file (open read write ioctl getattr))
(class process (ptrace signal sigkill sigstop setrlimit setsched transition dyntransition sigchld))
(class unix_stream_socket (connectto read write))
(class binder (call transfer))
(class capability (chown dac_override))
(class capability2 (syslog))
(class cap_userns (chown dac_override))
(class cap2_userns (syslog))
(class service_manager (find add))
(class property_service (set))
(classorder (file dir lnk_file fifo_file sock_file chr_file process unix_stream_socket binder capability capability2 cap_userns cap2_userns service_manager property_service))
(sensitivity s0)
(sensitivityorder (s0))
(category c0)
(categoryorder (c0))
(sensitivitycategory s0 (c0))
(user u)
(role r)
(role object_r)
(userrole u r)
(userrole u object_r)
(userlevel u (s0))
(userrange u ((s0) (s0 (c0))))
(sid kernel)
(sidorder (kernel))
(typeattribute domain)
(typeattribute untrusted_app_all)
(typeattribute isolated_app_all)
(typeattribute data_file_type)
(type kernel)
(type init)
(type shell)
(type system_server)
(type untrusted_app)
(type isolated_app)
(type andrixd)
(type andrix_owner)
(type andrix_home_file)
(type app_data_file)
(type cgroup)
(type cgroup_v2)
(type sysfs)
(roletype object_r sysfs)
(roletype r kernel)
(roletype r init)
(roletype r shell)
(roletype r system_server)
(roletype r untrusted_app)
(roletype r isolated_app)
(roletype r andrixd)
(roletype r andrix_owner)
(typeattributeset domain (kernel init shell system_server untrusted_app isolated_app andrixd andrix_owner))
(typeattributeset untrusted_app_all (untrusted_app))
(typeattributeset isolated_app_all (isolated_app))
(typeattributeset data_file_type (andrix_home_file app_data_file))
(sidcontext kernel (u r kernel ((s0) (s0))))
; grants that the rules' exceptions allow, so the control exercises them
(allow init andrixd (process (transition)))
(allow andrixd andrix_owner (process (transition sigchld)))
(allow andrix_owner andrix_home_file (file (read write open execute execute_no_trans)))
(allow init cgroup_v2 (file (read write open)))
(allow untrusted_app app_data_file (file (read write open)))
; grants that keep each attribute the rules name in the binary policy
(allow domain sysfs (dir (search)))
(allow untrusted_app_all app_data_file (file (getattr)))
(allow isolated_app_all sysfs (file (getattr)))
(allow init data_file_type (dir (search)))
; neverallow statements as an installed platform CIL file carries them. init compiles with -N,
; so a mutant that breaks one still compiles there; the build without -N checks them.
(neverallow domain andrix_owner (process (dyntransition)))
(neverallow andrix_owner andrixd (binder (call)))
