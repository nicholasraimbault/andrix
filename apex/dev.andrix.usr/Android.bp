linker_config {
    name: "dev.andrix.usr.linker.config",
    src: "linker.config.json",
    installable: false,
}

cc_binary {
    name: "andrix-hello",
    stem: "andrix-hello",
    srcs: ["andrix_hello.c"],
    // This C-only proof needs Bionic, not a packaged C++ runtime.
    stl: "none",
    ldflags: [
        "-Wl,-z,max-page-size=16384",
        "-Wl,-z,common-page-size=16384",
    ],
    compile_multilib: "64",
    min_sdk_version: "37",
    apex_available: ["dev.andrix.usr"],
}

soong_config_module_type {
    name: "andrix_usr_apex",
    module_type: "apex",
    config_namespace: "andrix",
    bool_variables: ["owner_compiler"],
    properties: ["manifest"],
}

andrix_usr_apex {
    name: "dev.andrix.usr",
    defaults: ["andrix_compiler_apex_payload"],
    soong_config_variables: {
        owner_compiler: {
            manifest: "apex_manifest_compiler.json",
            conditions_default: { manifest: "apex_manifest.json" },
        },
    },
    file_contexts: "file_contexts",
    key: "dev.andrix.usr.key",
    certificate: ":dev.andrix.usr.certificate",
    system_ext_specific: true,
    updatable: true,
    min_sdk_version: "37",
    binaries: ["andrix-hello"],
    prebuilts: ["dev.andrix.usr.linker.config"],
}
