// Ordinary, explicitly installed lab fixture. Never a product package.
android_test {
    name: "AndrixDebugBoundary",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    sdk_version: "37",
    min_sdk_version: "37",
    target_sdk_version: "37",
    compile_multilib: "64",
    jni_libs: ["libandrix_debug_boundary"],
    use_embedded_native_libs: true,
    certificate: ":dev.andrix.usr.certificate",
    auto_gen_config: false,
}
cc_library_shared {
    name: "libandrix_debug_boundary",
    srcs: ["probe.c", ":andrix_trace_access_source"],
    header_libs: ["andrix_trace_access_headers"],
    sdk_version: "37",
    min_sdk_version: "37",
    stl: "none",
    installable: false,
    compile_multilib: "64",
    enabled: false,
    arch: { arm64: { enabled: true } },
    cflags: ["-std=c11", "-Wall", "-Wextra", "-Werror"],
    ldflags: ["-Wl,-z,max-page-size=16384", "-Wl,-z,common-page-size=16384"],
}
