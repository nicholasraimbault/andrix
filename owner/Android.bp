// SPDX-License-Identifier: Apache-2.0
// Experimental primary-user owner session. No Vanadium/framework replacement.
aidl_interface {
    name: "andrix_session",
    unstable: true,
    srcs: ["aidl/dev/andrix/session/*.aidl"],
    local_include_dir: "aidl",
    backend: {
        cpp: { enabled: false },
        java: { enabled: true, platform_apis: true },
        ndk: { enabled: true },
    },
}

cc_defaults {
    name: "andrix_owner_defaults",
    cpp_std: "c++20",
    cflags: ["-Wall", "-Wextra", "-Werror"],
    system_ext_specific: true,
    srcs: ["native/session_core.cpp", "native/guards.cpp"],
}

soong_config_module_type {
    name: "andrix_lifecycle_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "andrix",
    bool_variables: ["owner_lifecycle"],
    properties: ["cflags", "srcs", "static_libs"],
}

andrix_lifecycle_cc_defaults {
    name: "andrix_lifecycle_build",
    soong_config_variables: {
        owner_lifecycle: {
            cflags: ["-DANDRIX_OWNER_LIFECYCLE=1"],
            srcs: ["native/platform_lifecycle.cpp", "native/lifecycle_core.cpp"],
            static_libs: ["andrix_platform_lifecycle-ndk"],
        },
    },
}

soong_config_module_type {
    name: "andrix_keep_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "andrix",
    bool_variables: ["owner_keep"],
    properties: ["cflags"],
}

andrix_keep_cc_defaults {
    name: "andrix_keep_build",
    soong_config_variables: {
        owner_keep: { cflags: ["-DANDRIX_OWNER_KEEP=1"] },
    },
}

soong_config_module_type {
    name: "andrix_keep_java_defaults",
    module_type: "java_defaults",
    config_namespace: "andrix",
    bool_variables: ["owner_keep"],
    properties: ["srcs"],
}

andrix_keep_java_defaults {
    name: "andrix_terminal_features",
    soong_config_variables: {
        owner_keep: {
            srcs: ["terminal/features/keep-enabled/ConsoleFeatures.java"],
            conditions_default: {
                srcs: ["terminal/features/keep-disabled/ConsoleFeatures.java"],
            },
        },
    },
}

cc_binary {
    name: "andrixd",
    defaults: ["andrix_owner_defaults", "andrix_lifecycle_build", "andrix_keep_build"],
    srcs: ["native/andrixd.cpp", "native/terminal_protocol.cpp"],
    static_libs: ["andrix_session-ndk"],
    shared_libs: ["libbase", "libbinder_ndk", "liblog", "libselinux"],
    init_rc: ["andrixd.rc"],
}

cc_binary {
    name: "andrix-session-runner",
    defaults: ["andrix_owner_defaults", "andrix_keep_build"],
    srcs: ["native/runner.cpp", "native/worker_filter.cpp"],
}

filegroup {
    name: "andrix_terminal_adapter_sources",
    srcs: ["terminal/adapter/*.java"],
}

android_app {
    name: "AndrixTerminal",
    defaults: ["andrix_terminal_features"],
    system_ext_specific: true,
    privileged: true,
    platform_apis: true,
    srcs: ["terminal/src/**/*.java", "terminal/protocol/*.java"],
    manifest: "terminal/AndroidManifest.xml",
    certificate: ":dev.andrix.usr.certificate",
    // The factory APK is authenticated by the read-only system image. Do not
    // install an update-only v4 sidecar beside it: per-file fs-verity is not set
    // up there. Prepare APK+v4 pairs separately for normal PackageInstaller updates.
    v4_signature: false,
    static_libs: ["andrix_session-java", "AndrixTerminalLibraries"],
}
