<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.andrix.terminal" android:versionCode="4" android:versionName="0.4-attach-state">
    <uses-sdk android:minSdkVersion="37" android:targetSdkVersion="37" />
    <!-- This system_ext console uses ServiceManager only to bootstrap its own
         local Binder interface. No shared UID or APK-declared permissions;
         GrapheneOS's implicit PM metadata is a separate observation. -->
    <application android:label="Andrix Terminal" android:allowBackup="false"
        android:usesNonSdkApi="true" android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".ConsoleActivity" android:exported="true"
            android:directBootAware="false" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
