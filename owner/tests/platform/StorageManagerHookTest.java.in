// Host facade for exact adapted framework methods, not Android runtime authority.
import com.android.server.storage.CeStorageAccessTracker;
import java.lang.annotation.Retention;
import java.lang.annotation.RetentionPolicy;
import java.util.*;
import java.util.concurrent.CountDownLatch;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicBoolean;
import java.util.concurrent.atomic.AtomicReference;
import java.util.function.Consumer;

@Retention(RetentionPolicy.SOURCE)
@interface UserIdInt {}

class RemoteException extends Exception {
    private static final long serialVersionUID = 1;
    RuntimeException rethrowAsRuntimeException() { throw new RuntimeException(this); }
}
interface DeathRecipient { void binderDied(); }
interface IBinder {
    void linkToDeath(DeathRecipient callback, int flags) throws RemoteException;
    boolean unlinkToDeath(DeathRecipient callback, int flags);
    boolean isBinderAlive();
}
interface IVold {
    IBinder asBinder();
    void setListener(Object listener) throws RemoteException;
    int[] getUnlockedUsers() throws RemoteException;
    void lockCeStorage(int user) throws RemoteException;
    void unlockCeStorage(int user, byte[] secret) throws RemoteException;
    default void reset() throws RemoteException { }
    default void onUserAdded(int id,int serial,int group) throws RemoteException { }
    default void onUserStarted(int id) throws RemoteException { }
    default void onSecureKeyguardStateChanged(boolean value) throws RemoteException { }
    final class Stub {
        static IVold asInterface(IBinder binder) { return ((FakeBinder) binder).service; }
    }
}
class FakeBinder implements IBinder {
    final List<DeathRecipient> callbacks = new ArrayList<>();
    final FakeVold service = new FakeVold(this);
    boolean alive = true;
    @Override public void linkToDeath(DeathRecipient callback, int flags) throws RemoteException {
        if (!alive) throw new RemoteException();
        callbacks.add(callback);
    }
    @Override public boolean unlinkToDeath(DeathRecipient callback, int flags) {
        return callbacks.remove(callback);
    }
    @Override public boolean isBinderAlive() { return alive; }
    void die() {
        if (!alive) return;
        alive = false;
        for (DeathRecipient callback : new ArrayList<>(callbacks)) callback.binderDied();
    }
}
class FakeVold implements IVold {
    final FakeBinder binder;
    Runnable onSet = () -> { }, onRestore = () -> { }, onLock = () -> { }, onUnlock = () -> { };
    boolean failSet, failLock, failUnlock;
    boolean loadedKey = true;
    int lockCalls;
    FakeVold(FakeBinder binder) { this.binder = binder; }
    @Override public IBinder asBinder() { return binder; }
    @Override public void setListener(Object listener) throws RemoteException {
        onSet.run(); if (failSet) throw new RemoteException();
    }
    @Override public int[] getUnlockedUsers() throws RemoteException {
        if (!binder.alive) throw new RemoteException();
        int[] snapshot = loadedKey ? new int[]{0} : new int[0];
        onRestore.run(); return snapshot;
    }
    @Override public void lockCeStorage(int user) throws RemoteException {
        ++lockCalls; onLock.run(); if (failLock) throw new RemoteException();
        loadedKey = false;
    }
    @Override public void unlockCeStorage(int user, byte[] secret) throws RemoteException {
        if (failUnlock) throw new RemoteException();
        loadedKey = true; // Vold completed; onUnlock models the pause before SMS cache append.
        onUnlock.run();
    }
}
class StorageManager {
    static boolean isFileEncrypted() { return true; }
}
class ServiceManager {
    static IBinder target;
    static boolean throwLookup;
    static IBinder getService(String name) {
        assert name.equals("vold");
        if (throwLookup) throw new IllegalStateException("lookup failure");
        return target;
    }
}
class BackgroundThread {
    static final ArrayDeque<Runnable> pending = new ArrayDeque<>();
    static BackgroundThread getHandler() { return new BackgroundThread(); }
    boolean postDelayed(Runnable task, long delay) {
        assert delay == 1000; pending.add(task); return true;
    }
}
class DateUtils { static final long SECOND_IN_MILLIS = 1000; }
class EmptyArray { static final int[] INT = new int[0]; }
class ArrayUtils { static boolean isEmpty(int[] values) { return values == null || values.length == 0; } }
class UserHandle { static final int USER_SYSTEM = 0; }
class UserManager {
    static boolean headless;
    static boolean isHeadlessSystemUserMode() { return headless; }
    List<UserInfo> getUsers() { return List.of(new UserInfo()); }
    static void invalidateIsUserUnlockedCache() { }
    boolean isUserRunning(int id) { return true; }
    boolean isUserUnlockingOrUnlocked(int id) { return true; }
}
class UserInfo {
    int id=0, serialNumber=0, profileGroupId=-1;
    boolean isCloneProfile() { return false; }
}
class FakeContext {
    <T> T getSystemService(Class<T> type) { return type.cast(new UserManager()); }
}
class FakeStorageSession {
    void onReset(IVold vold,Runnable callback) { callback.run(); }
}
class FakeHandler {
    void removeCallbacksAndMessages(Object token) { }
    FakeHandler obtainMessage(int what,int arg1,int arg2) { return this; }
    void sendToTarget() { }
}
class FakeStoraged { void onUserStarted(int id) { } }
class FakeInternal { void onReset(IVold vold) { } }
class Slog {
    static void w(String tag, String message) { }
    static void w(String tag, String message, Throwable error) { }
    static void d(String tag, String message) { }
    static void i(String tag, String message) { }
    static void e(String tag, String message, Throwable error) { }
    static void wtf(String tag, Throwable error) { }
}
class KeyPermission {
    boolean allowed = true;
    void lockCeStorage_enforcePermission() { if (!allowed) throw new SecurityException(); }
}

public final class StorageManagerHookTest extends KeyPermission {
    private static final String TAG = "host";
    private final Object mVoldConnectionLock = new Object(), mLock = new Object(), mListener = new Object();
    private boolean mConnectingVold;
    private volatile IVold mVold;
    private int connectedCalls;
    private boolean mBootCompleted=true, mDaemonConnected=true, mSecureKeyguardShowing;
    private final FakeContext mContext=new FakeContext();
    private final FakeStorageSession mStorageSessionController=new FakeStorageSession();
    private final FakeHandler mHandler=new FakeHandler();
    private final FakeStoraged mStoraged=new FakeStoraged();
    private final FakeInternal mStorageManagerInternal=new FakeInternal();
    private final Map<Integer,Integer> mDisks=new HashMap<>(), mVolumes=new HashMap<>();
    private final int[] mSystemUnlockedUsers={0};
    private static final int H_COMPLETE_UNLOCK_USER=1;
    private void extendWatchdogTimeout(String reason) { }
    private void addInternalVolumeLocked() { }
    // Scheduling facade only: every observation operation delegates to the real tracker.
    private static final class HookTracker {
        final CeStorageAccessTracker real;
        volatile Runnable afterConnected = () -> { };
        volatile Runnable afterRevocation = () -> { };
        HookTracker(Consumer<RuntimeException> errors) { real = new CeStorageAccessTracker(errors); }
        CeStorageAccessTracker.Snapshot register(int id, CeStorageAccessTracker.Listener listener) {
            return real.register(id, listener);
        }
        void connected(Object identity) { real.connected(identity); afterConnected.run(); }
        void died(Object identity) { real.died(identity); }
        CeStorageAccessTracker.Operation beginAvailable(int id, Object identity) {
            return real.beginAvailable(id, identity);
        }
        CeStorageAccessTracker.Operation beginRevocation(int id, Object identity) {
            var token = real.beginRevocation(id, identity); afterRevocation.run(); return token;
        }
        CeStorageAccessTracker.Operation beginRestore(Object identity) { return real.beginRestore(identity); }
        CeStorageAccessTracker.Operation beginReset(Object identity) { return real.beginReset(identity); }
        void complete(CeStorageAccessTracker.Operation token, boolean success) { real.complete(token, success); }
        void completeBulk(CeStorageAccessTracker.Operation token, boolean success, int[] users) {
            real.completeBulk(token, success, users);
        }
    }
    private final HookTracker mCeAccess = new HookTracker(error -> {
        throw new AssertionError(error);
    });
    private final Cache mCeUnlockedUsers = new Cache();
    private static final class Cache {
        final Set<Integer> values = new HashSet<>();
        void append(int id) { values.add(id); }
        void appendAll(int[] ids) { for (int id : ids) values.add(id); }
        void remove(int id) { values.remove(id); }
        int[] all() { return values.stream().mapToInt(Integer::intValue).toArray(); }
    }
    private static IBinder voldIdentity(IVold vold) { return vold == null ? null : vold.asBinder(); }
    private void onDaemonConnected() { ++connectedCalls; }
    public boolean isCeStorageUnlocked(int id) {
        synchronized (mLock) { return mCeUnlockedUsers.values.contains(id); }
    }
    private static final class Latest implements CeStorageAccessTracker.Listener {
        CeStorageAccessTracker.Snapshot state;
        @Override public void onStateChanged(CeStorageAccessTracker.Snapshot next) {
            if (state == null || next.sequence > state.sequence) state = next;
        }
    }

// EXACT_FRAMEWORK_METHODS

    private static StorageManagerHookTest connect(FakeBinder binder) {
        BackgroundThread.pending.clear(); ServiceManager.target = binder;
        StorageManagerHookTest test = new StorageManagerHookTest();
        test.connectVold(); assert test.mVold == binder.service && !test.mConnectingVold;
        assert test.connectedCalls == 1 && test.isCeStorageUnlocked(0);
        return test;
    }

    // Identity is installed before mVold is exposed. A lock that still races the
    // initial restore, including one that captured a null binder, cannot leave
    // observation available. No preexisting SMS cache is required.
    private static void publicationDoesNotBypassRevocation() throws Exception {
        StorageManagerHookTest test = new StorageManagerHookTest();
        FakeBinder keys = new FakeBinder(); ServiceManager.target = keys;
        Latest latest = new Latest(); latest.onStateChanged(test.mCeAccess.register(0, latest));
        assert !test.isCeStorageUnlocked(0);
        CountDownLatch identity = new CountDownLatch(1), connectMayProceed = new CountDownLatch(1);
        test.mCeAccess.afterConnected = () -> { identity.countDown(); await(connectMayProceed); };
        Thread connection = new Thread(test::connectVold);
        connection.start(); await(identity);
        assert test.mVold == null : "binder must not be visible before identity handoff returns";
        connectMayProceed.countDown(); connection.join(6000);
        assert !connection.isAlive() && test.mVold == keys.service;
        test.mCeAccess.afterConnected = () -> { };
        assert latest.state.available && keys.service.loadedKey; // Ordinary first restore.

        StorageManagerHookTest raced = new StorageManagerHookTest();
        FakeBinder binder = new FakeBinder(); ServiceManager.target = binder;
        Latest observed = new Latest(); observed.onStateChanged(raced.mCeAccess.register(0, observed));
        CountDownLatch restoring = new CountDownLatch(1), restoreMayProceed = new CountDownLatch(1);
        CountDownLatch revoked = new CountDownLatch(1), lockMayProceed = new CountDownLatch(1);
        AtomicReference<Throwable> problem = new AtomicReference<>();
        binder.service.onRestore = () -> { restoring.countDown(); await(restoreMayProceed); };
        raced.mCeAccess.afterRevocation = () -> { revoked.countDown(); await(lockMayProceed); };
        Thread restore = new Thread(() -> { try { raced.connectVold(); } catch (Throwable e) { problem.set(e); } });
        Thread locking = new Thread(() -> { try { raced.lockCeStorage(0); } catch (Throwable e) { problem.set(e); } });
        try {
            restore.start(); await(restoring);
            assert raced.mVold == binder.service; // Published only after identity install.
            locking.start(); await(revoked);
            restoreMayProceed.countDown(); restore.join(6000);
            assert !restore.isAlive() && problem.get() == null : String.valueOf(problem.get());
            lockMayProceed.countDown(); locking.join(6000);
            assert !locking.isAlive() && problem.get() == null : String.valueOf(problem.get());
            assert !binder.service.loadedKey && !raced.isCeStorageUnlocked(0);
            assert !observed.state.available : "restore must not outrank an overlapping lock";
            raced.resetIfBootedAndConnected();
            assert !observed.state.available : "reset must not launder the raced cache append";
        } finally {
            raced.mCeAccess.afterRevocation = () -> { };
            binder.service.onRestore = () -> { };
            restoreMayProceed.countDown(); lockMayProceed.countDown();
            restore.join(6000);
            if (locking.getState() != Thread.State.NEW) locking.join(6000);
        }
    }

    private static void await(CountDownLatch latch) {
        try { if (!latch.await(5, TimeUnit.SECONDS)) throw new AssertionError("barrier timeout"); }
        catch (InterruptedException error) { throw new AssertionError(error); }
    }

    public static void main(String[] args) throws Exception {
        FakeBinder first = new FakeBinder(); StorageManagerHookTest test = connect(first);
        test.connectVold(); assert first.callbacks.size() == 1; // No duplicate live binding.
        DeathRecipient oldCallback = first.callbacks.get(0);
        FakeBinder replacement = new FakeBinder(); ServiceManager.target = replacement;
        first.die(); assert test.mVold == replacement.service && test.connectedCalls == 2;
        oldCallback.binderDied(); assert test.mVold == replacement.service;

        // Dead reference before its callback, followed by missing lookup: must retry.
        replacement.alive = false; ServiceManager.target = null;
        test.connectVold(); assert test.mVold == null && BackgroundThread.pending.size() == 1;
        BackgroundThread.pending.clear();
        ServiceManager.throwLookup = true;
        try { test.connectVold(); throw new AssertionError("lookup should throw"); }
        catch (IllegalStateException expected) { assert !test.mConnectingVold; }
        ServiceManager.throwLookup = false;

        FakeBinder rejected = new FakeBinder(); rejected.service.failSet = true;
        ServiceManager.target = rejected; test.connectVold();
        assert test.mVold == null && rejected.callbacks.isEmpty() && BackgroundThread.pending.size() == 1;
        BackgroundThread.pending.clear();
        FakeBinder diedBeforePublication = new FakeBinder();
        diedBeforePublication.service.onSet = diedBeforePublication::die;
        ServiceManager.target = diedBeforePublication; test.connectVold();
        assert test.mVold == null && BackgroundThread.pending.size() == 1;

        // Death during connected() now happens before mVold is exposed. The
        // connection lock is reentrant; the callback must not publish a dead binder.
        BackgroundThread.pending.clear();
        StorageManagerHookTest race = new StorageManagerHookTest(); FakeBinder dying = new FakeBinder();
        AtomicBoolean once = new AtomicBoolean();
        race.mCeAccess.register(0, state -> {
            if (once.compareAndSet(false, true)) dying.die();
        });
        ServiceManager.target = dying; race.connectVold();
        assert race.mVold == null && !race.mConnectingVold && BackgroundThread.pending.size() == 1;

        FakeBinder keys = new FakeBinder(); StorageManagerHookTest keyTest = connect(keys);
        Latest latest = new Latest(); latest.onStateChanged(keyTest.mCeAccess.register(0, latest));
        assert latest.state.available;
        keys.service.onLock = () -> { assert !latest.state.available; };
        keys.service.failLock = true;
        keyTest.lockCeStorage(0);
        assert keyTest.isCeStorageUnlocked(0) && !latest.state.available;
        keys.service.failLock = false; keyTest.lockCeStorage(0);
        assert !keyTest.isCeStorageUnlocked(0);
        keyTest.lockCeStorage(0); assert keys.service.lockCalls == 2; // Upstream no-op retained.
        long sequence = latest.state.sequence;
        keyTest.allowed = false;
        try { keyTest.lockCeStorage(0); throw new AssertionError("permission"); }
        catch (SecurityException expected) { assert latest.state.sequence == sequence; }
        keyTest.allowed = true; UserManager.headless = true;
        try { keyTest.lockCeStorage(0); throw new AssertionError("headless"); }
        catch (IllegalArgumentException expected) { assert latest.state.sequence == sequence; }
        UserManager.headless = false;

        // Model a prior successful unlock, then race an exact locking method
        // between vold's captured restoration list and its delayed response.
        keys.service.loadedKey = true;
        keyTest.mCeUnlockedUsers.appendAll(new int[]{0});
        keyTest.mCeAccess.complete(keyTest.mCeAccess.beginAvailable(0, keys), true);
        keys.service.onRestore = () -> keyTest.lockCeStorage(0);
        keyTest.restoreCeUnlockedUsers(keys.service);
        assert !keys.service.loadedKey && keyTest.isCeStorageUnlocked(0);
        assert !latest.state.available; // Initial reply fence works, despite stale cache append.
        keys.service.onRestore = () -> { };
        keyTest.resetIfBootedAndConnected(); // Exact adapted reset, not just tracker calls.
        assert !keys.service.loadedKey && keyTest.isCeStorageUnlocked(0);
        assert !latest.state.available : "stale cache must not restore authority through reset";
        keyTest.resetIfBootedAndConnected();
        assert !latest.state.available : "repeated reset must not launder unknown provenance";
        // A fresh successful key operation supplies new evidence. Ordinary reset
        // can then preserve that verified availability, not invent it from cache.
        keys.service.loadedKey = true;
        keyTest.mCeAccess.complete(keyTest.mCeAccess.beginAvailable(0, keys), true);
        assert latest.state.available;
        keyTest.resetIfBootedAndConnected();
        assert keys.service.loadedKey && latest.state.available;

        // Unlock success, pause before cache append; concurrent lock revokes;
        // delayed append must not restore authority through later reset.
        keys.service.onUnlock = () -> keyTest.lockCeStorage(0);
        keyTest.unlockCeStorage(0, new byte[]{1});
        assert keyTest.isCeStorageUnlocked(0) && !keys.service.loadedKey;
        assert !latest.state.available;
        keys.service.onUnlock = () -> { };
        keyTest.resetIfBootedAndConnected();
        assert !latest.state.available : "stale unlock cache must not restore authority through reset";

        publicationDoesNotBypassRevocation();
        System.out.println("Exact framework connection/lock/restore/reset methods passed; Android unqualified");
    }
}
