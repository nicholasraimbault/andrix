// Exact production failure callback with portable UI-state adapters, not Android authority.
import dev.andrix.terminal.protocol.AttachmentLifecycle;
import dev.andrix.terminal.protocol.AttachmentLifecycle.Request;

public final class AttachFailureTest {
    private interface Listener { }
    private final AttachmentLifecycle<Object> attachments = new AttachmentLifecycle<>();
    private long uiEpoch = 1;
    private Listener listener = new Listener() { };
    private boolean allowed = true;
    private String state = "Attaching";
    private int publications;
    private final Thread main = Thread.currentThread();
    private void requireMain() {
        if (Thread.currentThread() != main) throw new AssertionError("Not main");
    }
    private boolean eligible() { return allowed; }
    private void show(String text) { state = text; ++publications; }

// PRODUCTION_FAILURE_CALLBACK

    public static void main(String[] args) {
        AttachFailureTest h = new AttachFailureTest();
        Request first = h.attachments.begin();
        h.failAttach(first, 1, h.listener, "native failure");
        assert !h.attachments.preparing() && h.publications == 1;
        assert h.state.equals("Attach failed: native failure");

        Request cancelled = h.attachments.begin();
        h.uiEpoch = 2; h.state = "Detached"; h.attachments.cancel();
        h.failAttach(cancelled, 1, h.listener, "late failure");
        assert !h.attachments.preparing() && h.publications == 1;
        assert h.state.equals("Detached");

        Request rebound = h.attachments.begin();
        h.failAttach(rebound, 2, new Listener() { }, "old Activity");
        assert !h.attachments.preparing() && h.publications == 1;
        assert h.state.equals("Detached");

        Request locked = h.attachments.begin(); h.allowed = false; h.state = "Locked";
        h.failAttach(locked, 2, h.listener, "ineligible");
        assert !h.attachments.preparing() && h.publications == 1;
        assert h.state.equals("Locked");

        Request newer = h.attachments.begin(); h.allowed = true; h.uiEpoch = 3;
        h.failAttach(locked, 2, h.listener, "duplicate old completion");
        assert h.attachments.current(newer) && h.publications == 1;
        System.out.println("Actual stale-attachment failure callback passed; Android unqualified");
    }
}
