// SPDX-License-Identifier: Apache-2.0
// Opt-in system_server adapter; not an APK and not a replacement Android service.
aidl_interface {
    name: "andrix_platform_lifecycle",
    unstable: true,
    srcs: ["aidl/dev/andrix/lifecycle/*.aidl"],
    local_include_dir: "aidl",
    backend: {
        cpp: { enabled: false },
        java: { enabled: true, platform_apis: true },
        ndk: { enabled: true },
    },
}

soong_config_module_type {
    name: "andrix_platform_keep_java_defaults",
    module_type: "java_defaults",
    config_namespace: "andrix",
    bool_variables: ["owner_keep"],
    properties: ["srcs"],
}

andrix_platform_keep_java_defaults {
    name: "andrix_platform_keep_build",
    soong_config_variables: {
        owner_keep: {
            srcs: ["config/enabled/**/*.java"],
            conditions_default: {
                srcs: ["config/disabled/**/*.java"],
            },
        },
    },
}

java_library {
    name: "andrix-owner-lifecycle",
    defaults: ["andrix_platform_keep_build"],
    system_ext_specific: true,
    installable: true,
    srcs: ["java/**/*.java"],
    libs: ["services.impl"],
    static_libs: ["andrix_platform_lifecycle-java"],
    optimize: {
        enabled: true,
        optimize: true,
        shrink: true,
        ignore_warnings: false,
        proguard_flags_files: ["proguard.flags"],
    },
}
